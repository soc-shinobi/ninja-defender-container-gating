// =============================================================================
// Workload plane (resource-group scope): Log Analytics, ACR, managed identities,
// AKS (via module), Container Apps (app + control panel) with optional Entra
// auth, and optional Foundry (AI Services + project + model deployment).
// =============================================================================

param location string
param acaLocation string = location
param namePrefix string
param acaEnvironmentName string = '${namePrefix}-aca-env'
param adminPrincipalId string
param aksNodeVmSize string

@description('Azure Policy for Kubernetes (gatekeeper). Off by default: Defender enforces misconfiguration rules as VAPs, so the five gatekeeper/azure-policy pods buy nothing here.')
param deployAzurePolicy bool = false

@description('Azure Disk/File CSI drivers + snapshot controller. Off by default: nothing in this lab uses a PersistentVolumeClaim.')
param deployCsiDrivers bool = false

@description('Container Insights add-on (ama-logs). Off by default to keep the node free for the Defender sensor and gating admission controller.')
param deployContainerInsights bool = false

@description('AKS system node count. Default 2: Defender gating + sensor do not fit beside the platform pods on a single 2-vCPU node.')
param aksNodeCount int = 2
param deployFoundry bool
param aiModelName string
param aiModelVersion string
param defenderSensorViaHelm bool = false

@description('Send securityGating.identities inside the AKS cluster body. Documented from api-version 2025-05-02-preview, but the ContainerService resource provider rejected it in swedencentral on 2026-09-19 (UnmarshalError: unknown field "identities"). Default false: the cluster is created without it and infra/postdeploy/attach-gating-identity.sh attaches the identity afterwards. See infra/modules/aks.bicep.')
param attachGatingIdentities bool = false

@description('Namespace the Defender admission-controller ServiceAccount lives in. The add-on always uses kube-system; the Helm chart uses mdc on a standard AKS cluster and kube-system on AKS Automatic. The federated credential subject MUST match, or the gating agent cannot exchange its token and the image gate has no findings to read.')
param defenderSensorNamespace string = ''

@description('Deploy Flux (AKS GitOps extension) syncing app/k8s from gitRepoUrl. Act 4 GitOps-denied-by-the-gate beat.')
param deployFlux bool = true
@description('HTTPS URL of this repo. Required when deployFlux is true.')
param gitRepoUrl string = ''
@description('Optional GitHub PAT for Flux to clone a private repository.')
@secure()
param gitRepoToken string = ''
param gitBranch string = 'main'

@description('Control-panel kubectl console mode: readonly | demo | unrestricted.')
@allowed([ 'readonly', 'demo', 'unrestricted' ])
param kubectlMode string = 'demo'

@description('Entra user (UPN or object ID) allowed to open the panel. EMPTY = basic-auth mode.')
param panelEntraUser string = ''
@description('Random basic-auth password, generated by deploy.sh. Only used when panelEntraUser is empty.')
@secure()
param panelBasicPassword string = ''
@description('Basic-auth username when in basic mode. Change it per deployment with PANEL_BASIC_USER; the app reads it from the BASIC_AUTH_USER environment variable, so it can also be swapped on a live app with `az containerapp update --set-env-vars`.')
param panelBasicUser string = 'panel'

@description('Control-panel image. Empty uses the port-80 Container Apps quickstart image until build-push-app.sh switches ingress to 8080 and installs the real image.')
param appImage string = ''

@description('API key for machine access to the REST API. Sent as the X-API-Key header, accepted on /api/* only. Stored as a Container App secret; deploy.sh generates one when empty.')
@secure()
param panelApiKey string = ''

@description('OPT-IN: put the Container Apps environment in a VNet with an egress-only NSG. Adds ~$26/month (managed load balancer + 2 public IPs). See ACA-readme.md.')
param enableAcaVnet bool = false
@description('Address space for the lab VNet. Only used when enableAcaVnet is true.')
param acaVnetAddressPrefix string = '10.60.0.0/16'
@description('Subnet for the Container Apps environment. /27 is the minimum and subnets cannot be resized later.')
param acaSubnetPrefix string = '10.60.0.0/26'
@description('AKS API server public IP, to pin the egress rule. Empty falls back to the regional AzureCloud tag.')
param aksApiServerIp string = ''

var suffix = uniqueString(resourceGroup().id)
var acrName = toLower('${namePrefix}acr${substring(suffix, 0, 6)}')
var aksName = '${namePrefix}-aks'
var lawName = '${namePrefix}-law'
var acaEnvName = acaEnvironmentName
var acaAppName = '${namePrefix}-app'
var foundryName = '${namePrefix}-foundry-${substring(suffix, 0, 5)}'
var sensitiveStorageName = toLower('st${namePrefix}${substring(suffix, 0, 8)}')

// Well-known role definition IDs
var acrPullRoleId = '7f951dda-4ed3-4680-a7ca-43fe172d538d'
var cognitiveOpenAiUserRoleId = '5e0bd9bd-7b93-4f28-af87-19fc36ad61bd'
// AKS Azure-RBAC-for-Kubernetes built-in roles (verified against the built-in roles reference).
var aksRbacReaderRoleId = '7f6c6a51-bcf8-42ba-9220-52d62157d7db'
// Azure Kubernetes Service Cluster User Role: listClusterUserCredential only.
var aksClusterUserRoleId = '4abbcc35-e782-43d8-92c5-2d3f1bd2253f'
// Azure Kubernetes Service RBAC Cluster Admin: full Kubernetes data plane, for the lab admin's Entra login.
var aksRbacClusterAdminRoleId = 'b1ff04bb-8a4e-4dc4-8eb5-8693973ce19b'
// Security Reader: read security alerts, recommendations and policy state. The panel's
// alerts blade queries Azure Resource Graph, which returns only the rows the caller may
// read, so this is what makes the blade non-empty - scoped to the lab resource group.
var securityReaderRoleId = '39bc4728-0917-49c7-9d2c-d95423bc2eb4'
var storageBlobDataReaderRoleId = '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1'

// ---- Log Analytics --------------------------------------------------------
resource law 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: lawName
  location: location
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

// ---- Azure Container Registry ---------------------------------------------
// adminUserEnabled: true is a DELIBERATE weakness for the "registry hygiene"
// posture beat. Defender CSPM will flag it. Turn off in a real environment.
resource acr 'Microsoft.ContainerRegistry/registries@2023-11-01-preview' = {
  name: acrName
  location: location
  sku: { name: 'Basic' }
  properties: {
    adminUserEnabled: true
  }
}

// ---- Identity: gating admission controller (pulls findings artifacts) ------
resource gatingIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${namePrefix}-gating-id'
  location: location
}

// ---- Identity: the Container App workload ----------------------------------
resource appIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${namePrefix}-app-id'
  location: location
}

// AKS web app identity: reads fake sensitive records from Blob without an account key.
resource aksWebappIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${namePrefix}-aks-webapp-id'
  location: location
}

resource sensitiveStorage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: sensitiveStorageName
  location: location
  tags: {
    purpose: 'aks-sensitive-demo'
    dataClassification: 'fake-confidential'
  }
  sku: { name: 'Standard_LRS' }
  kind: 'StorageV2'
  properties: {
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false // seed script enables it only for upload, then restores false
    publicNetworkAccess: 'Enabled'
  }
}

resource sensitiveBlobService 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = {
  parent: sensitiveStorage
  name: 'default'
}

resource sensitiveContainer 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: sensitiveBlobService
  name: 'sensitive-data'
  properties: {
    publicAccess: 'None'
  }
}

resource aksWebappBlobReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(sensitiveContainer.id, aksWebappIdentity.id, storageBlobDataReaderRoleId)
  scope: sensitiveContainer
  properties: {
    principalId: aksWebappIdentity.properties.principalId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', storageBlobDataReaderRoleId)
    principalType: 'ServicePrincipal'
  }
}

// gating identity needs AcrPull on the registry
resource gatingAcrPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(acr.id, gatingIdentity.id, acrPullRoleId)
  scope: acr
  properties: {
    principalId: gatingIdentity.properties.principalId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', acrPullRoleId)
    principalType: 'ServicePrincipal'
  }
}

// app identity needs AcrPull to run its own image
resource appAcrPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(acr.id, appIdentity.id, acrPullRoleId)
  scope: acr
  properties: {
    principalId: appIdentity.properties.principalId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', acrPullRoleId)
    principalType: 'ServicePrincipal'
  }
}

// The CLUSTER pulls the demo images too, and it pulls them as its KUBELET identity, not as
// the app identity. Without this the alert-simulation Job and the hero deployments stop at
// ErrImagePull, which reads like a broken image rather than a missing role.
// ---- AKS ------------------------------------------------------------------
module aks 'aks.bicep' = {
  name: 'aks'
  params: {
    location: location
    aksName: aksName
    nodeVmSize: aksNodeVmSize
    nodeCount: aksNodeCount
    deployContainerInsights: deployContainerInsights
    deployCsiDrivers: deployCsiDrivers
    deployAzurePolicy: deployAzurePolicy
    logAnalyticsId: law.id
    gatingIdentityResourceId: gatingIdentity.id
    gatingIdentityClientId: gatingIdentity.properties.clientId
    gatingIdentityObjectId: gatingIdentity.properties.principalId
    acrLoginServer: acr.properties.loginServer
    defenderSensorViaHelm: defenderSensorViaHelm
    attachGatingIdentities: attachGatingIdentities
  }
}

// The CLUSTER pulls the demo images as its KUBELET identity, not as the app identity.
// Without this the alert-simulation Job and the hero deployments stop at ErrImagePull, which
// reads like a broken image rather than a missing role. It goes through a module because a
// role assignment name cannot be built from a module output (BCP120).
module kubeletAcrPull 'acr-pull.bicep' = {
  name: 'kubelet-acr-pull'
  params: {
    acrName: acr.name
    principalId: aks.outputs.kubeletIdentityObjectId
  }
}

// Federated identity credential for the gating identity, bound to the AKS OIDC
// issuer and the Defender admission controller service account. Created AFTER
// the cluster because it needs the OIDC issuer URL.
resource gatingFic 'Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials@2023-01-31' = {
  parent: gatingIdentity
  name: 'defender-admission-controller'
  properties: {
    issuer: aks.outputs.oidcIssuerUrl
    subject: 'system:serviceaccount:${empty(defenderSensorNamespace) ? (defenderSensorViaHelm ? 'mdc' : 'kube-system') : defenderSensorNamespace}:defender-admission-controller-serviceaccount'
    audiences: [ 'api://AzureADTokenExchange' ]
  }
}

resource aksWebappFic 'Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials@2023-01-31' = {
  parent: aksWebappIdentity
  name: 'aks-webapp-x-mdc-allowed'
  properties: {
    issuer: aks.outputs.oidcIssuerUrl
    subject: 'system:serviceaccount:x-mdc-allowed:aks-webapp'
    audiences: [ 'api://AzureADTokenExchange' ]
  }
}

// ---- Optional VNet + egress NSG for the Container Apps environment --------
// Off by default. The subnet ID is computed with resourceId() rather than read from the
// module output, so nothing dereferences a conditional module when the flag is false.
var acaVnetName = '${namePrefix}-vnet'
var acaSubnetName = 'aca-infra'
var acaSubnetId = resourceId('Microsoft.Network/virtualNetworks/subnets', acaVnetName, acaSubnetName)

module acaNetwork 'aca-network.bicep' = if (enableAcaVnet) {
  name: 'aca-network'
  params: {
    location: acaLocation
    namePrefix: namePrefix
    vnetAddressPrefix: acaVnetAddressPrefix
    acaSubnetPrefix: acaSubnetPrefix
    subnetName: acaSubnetName
    aksApiServerIp: aksApiServerIp
    allowFoundry: deployFoundry
  }
}

// ---- Container Apps environment + app -------------------------------------
resource acaEnv 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: acaEnvName
  location: acaLocation
  // Only depends on the network when the network is actually deployed.
  dependsOn: enableAcaVnet ? [ acaNetwork ] : []
  properties: union({
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: law.properties.customerId
        sharedKey: law.listKeys().primarySharedKey
      }
    }
  }, enableAcaVnet ? {
    // workloadProfiles makes this a v2 environment. Without it you get the legacy
    // consumption-only type, which needs a far broader NSG rule set to function.
    vnetConfiguration: {
      infrastructureSubnetId: acaSubnetId
      internal: false
    }
    workloadProfiles: [
      {
        name: 'Consumption'
        workloadProfileType: 'Consumption'
      }
    ]
  } : {})
}

resource acaApp 'Microsoft.App/containerApps@2024-03-01' = {
  name: acaAppName
  location: acaLocation
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: {
      '${appIdentity.id}': {}
    }
  }
  properties: {
    // No workloadProfileName: in a v2 environment an app without one lands on the
    // default Consumption profile, which is exactly what we want.
    managedEnvironmentId: acaEnv.id
    configuration: {
      // Basic-auth password and the API key live as Container App SECRETS, never as plain
      // env values.
      secrets: union(
        empty(panelEntraUser) && !empty(panelBasicPassword) ? [
          { name: 'panel-basic-password', value: panelBasicPassword }
        ] : [],
        !empty(panelApiKey) ? [
          { name: 'panel-api-key', value: panelApiKey }
        ] : [])
      ingress: {
        external: true
        // The bootstrap image listens on 80. build-push-app.sh switches ingress to 8080
        // when it installs the real control panel, avoiding an unhealthy first revision.
        targetPort: empty(appImage) ? 80 : 8080
        transport: 'auto'
      }
      registries: [
        {
          server: acr.properties.loginServer
          identity: appIdentity.id
        }
      ]
    }
    template: {
      containers: [
        {
          // Placeholder image until the demo app is built and pushed.
          // Replace with ${acr.properties.loginServer}/webapp:<tag>.
          name: 'app'
          image: empty(appImage) ? 'mcr.microsoft.com/k8se/quickstart:latest' : appImage
          resources: {
            cpu: json('0.5')
            memory: '1Gi'
          }
          env: union([
            // Control panel -> cluster
            { name: 'AKS_NAME', value: aksName }
            { name: 'AKS_API_FQDN', value: aks.outputs.aksFqdn }
            // Lets the app fetch the cluster CA (listClusterUserCredential) so it can verify
            // the API server certificate, which is signed by the cluster's own CA.
            { name: 'AKS_RESOURCE_ID', value: aks.outputs.aksId }
            { name: 'RUNNER_NAMESPACE', value: 'demo-ops' }
            // Defender alert-simulation image (app/mdc-alert-simulation), run as a Job by
            // the control panel. Empty until `make app` has built and pushed it.
            { name: 'ALERT_SIM_IMAGE', value: '${acr.properties.loginServer}/mdc-alert-triage:latest' }
            { name: 'ALERT_SIM_NAMESPACE', value: 'demo-ops' }
            // readonly | demo | unrestricted. 'demo' enables the scripted simulations.
            { name: 'KUBECTL_MODE', value: kubectlMode }
            { name: 'AZURE_CLIENT_ID', value: appIdentity.properties.clientId }
            { name: 'APP_IDENTITY_CLIENT_ID', value: appIdentity.properties.clientId }
            // Optional Foundry chat; empty string hides the panel entirely.
            { name: 'FOUNDRY_ENDPOINT', value: deployFoundry ? foundry!.outputs.endpoint : '' }
            { name: 'AI_MODEL_NAME', value: aiModelName }
          ], empty(panelEntraUser) && !empty(panelBasicPassword) ? [
            // basic mode: the app enforces HTTP Basic itself
            { name: 'BASIC_AUTH_USER', value: panelBasicUser }
            { name: 'BASIC_AUTH_PASSWORD', secretRef: 'panel-basic-password' }
          ] : [], !empty(panelApiKey) ? [
            // machine mode: X-API-Key on /api/* only
            { name: 'PANEL_API_KEY', secretRef: 'panel-api-key' }
          ] : [])
        }
      ]
      scale: {
        minReplicas: 1
        maxReplicas: 1
      }
    }
  }
}

// NOTE: Entra built-in auth (EasyAuth) is deliberately NOT configured here. It needs an app
// registration and a client secret, which are Microsoft Graph objects ARM cannot create.
// Run `make auth` (infra/postdeploy/enable-aca-auth.sh) right after deploying: the control
// panel is a remote shell into the cluster and has NO authentication until you do.

// ---- Control panel access to the cluster ----------------------------------
// The Container App reads the cluster with its managed identity. Cluster-scope READER only:
// the overview and pod list need to see every namespace, but nothing here grants write or
// exec. The exec permission (AKS RBAC Writer scoped to /namespaces/demo-ops) is granted
// post-deploy by infra/postdeploy/grant-controlpanel-access.sh, because a namespace-scoped
// assignment targets '<clusterId>/namespaces/<ns>', which Bicep cannot express as a scope.
resource aksExisting 'Microsoft.ContainerService/managedClusters@2025-05-02-preview' existing = {
  name: aksName
}

resource appAksReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  // name must be computable at the START of the deployment, so it is derived from the
  // existing-resource id (a function of the name), never from a module output.
  name: guid(aksExisting.id, appIdentity.id, aksRbacReaderRoleId)
  scope: aksExisting
  dependsOn: [ aks ]   // the cluster must exist before the assignment lands
  properties: {
    principalId: appIdentity.properties.principalId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', aksRbacReaderRoleId)
    principalType: 'ServicePrincipal'
  }
}

// The panel reads the cluster CA out of the kubeconfig to verify the API server
// certificate. Cluster User is the role that permits listClusterUserCredential; it grants
// no Kubernetes permissions of its own (those come from the namespace-scoped RBAC roles).
resource appAksClusterUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(aksExisting.id, appIdentity.id, aksClusterUserRoleId)
  scope: aksExisting
  dependsOn: [ aks ]
  properties: {
    principalId: appIdentity.properties.principalId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', aksClusterUserRoleId)
    principalType: 'ServicePrincipal'
  }
}

// The signed-in deployer gets Kubernetes admin through Entra (kubelogin), not only the local
// admin kubeconfig. Subscription Owner does not cover this: with Azure RBAC for Kubernetes,
// data-plane access is a dataAction, and Owner grants none.
resource adminAksClusterAdmin 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (!empty(adminPrincipalId)) {
  name: guid(aksExisting.id, adminPrincipalId, aksRbacClusterAdminRoleId)
  scope: aksExisting
  dependsOn: [ aks ]
  properties: {
    principalId: adminPrincipalId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', aksRbacClusterAdminRoleId)
    principalType: 'User'
  }
}

// The control panel reads Defender alerts for this cluster through Resource Graph.
resource appSecurityReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, appIdentity.id, securityReaderRoleId)
  properties: {
    principalId: appIdentity.properties.principalId
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', securityReaderRoleId)
    principalType: 'ServicePrincipal'
  }
}

// ---- Flux GitOps (AKS extension) ------------------------------------------
module flux 'flux.bicep' = if (deployFlux) {
  name: 'flux'
  params: {
    aksName: aks.outputs.aksName
    gitRepoUrl: gitRepoUrl
    gitBranch: gitBranch
    gitRepoToken: gitRepoToken
    acrLoginServer: acr.properties.loginServer
    heartbeatUrl: 'https://${acaApp.properties.configuration.ingress.fqdn}/healthz'
  }
}

// ---- Foundry (AI Services + project + model deployment) --------------------
module foundry 'foundry.bicep' = if (deployFoundry) {
  name: 'foundry'
  params: {
    location: location
    foundryName: foundryName
    modelName: aiModelName
    modelVersion: aiModelVersion
    appIdentityPrincipalId: appIdentity.properties.principalId
    adminPrincipalId: adminPrincipalId
    openAiUserRoleId: cognitiveOpenAiUserRoleId
  }
}

output logAnalyticsId string = law.id
output acrLoginServer string = acr.properties.loginServer
output aksName string = aks.outputs.aksName
output acaAppUrl string = 'https://${acaApp.properties.configuration.ingress.fqdn}'
output gatingIdentityClientId string = gatingIdentity.properties.clientId
output appIdentityClientId string = appIdentity.properties.clientId
output aksWebappIdentityClientId string = aksWebappIdentity.properties.clientId
output sensitiveStorageAccountName string = sensitiveStorage.name
output sensitiveStorageBlobUrl string = 'https://${sensitiveStorage.name}.blob.${environment().suffixes.storage}'
output foundryEndpoint string = deployFoundry ? foundry!.outputs.endpoint : ''
